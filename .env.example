# ─────────────────────────────────────────────────────────────────────────────
# LMS Frontend — Environment Variables Reference
#
# Copy this file to .env and fill in values before running the dev server.
# All variables MUST be prefixed with VITE_ to be accessible in the browser.
# Never commit your actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── API Configuration ★ ───────────────────────────────────────────────────────

# ★ REQUIRED — Full URL to the backend API (no trailing slash)
# Local development:  http://localhost:3000/api
# Production (Railway): https://your-backend.railway.app/api
VITE_API_BASE_URL=http://localhost:3000/api


# ── App Metadata ─────────────────────────────────────────────────────────────

# Display name shown in the browser tab and UI headers
VITE_APP_NAME=Learning Management System

# Deployment environment label used for debugging (not used in logic)
# Values: development | staging | production
VITE_APP_ENV=development
